FROM ubuntu:22.04

# Instalar dependências
RUN apt-get update && apt-get install -y \
    wget curl gnupg ca-certificates pulseaudio ffmpeg git xvfb x11-utils x11vnc \
    libnss3 libatk1.0-0 libatk-bridge2.0-0 libcups2 libxcomposite1 libxdamage1 libxrandr2 libgbm1 libpango1.0-0 libasound2 \
    && rm -rf /var/lib/apt/lists/*

# Node.js
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs

# Criar app
WORKDIR /app
COPY package.json .
RUN npm install
COPY . .

# Expor porta
EXPOSE 3000

# Start
CMD ["node", "server.js"]